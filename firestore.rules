rules_version = '2';

// חוקי הגישה למסד הנתונים.
//
// תצורת Firebase ל-web היא ציבורית מעצם התכנון — היא חייבת להגיע
// לדפדפן, וכל אחד יכול לקרוא אותה מהקוד. לכן החוקים כאן הם ההגנה
// היחידה על הנתונים, ולא הסתרת המפתחות.
//
// העיקרון: משתמש ניגש אך ורק למסמכים שתחת המזהה שלו. אין כלל שמתיר
// קריאה רוחבית, ולכן גם משתמש מחובר אינו יכול לראות נסיעות של אחר.
//
// פריסה:  firebase deploy --only firestore:rules
// או הדבקה בקונסולה: Firestore Database → Rules → Publish

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // כל מה שתחת המשתמש — נסיעות, הזמנות שיובאו מהמייל וסימוני מחיקה.
    // המרכיב {document=**} מכסה גם תת-אוספים עתידיים; בלעדיו כל אוסף
    // חדש נחסם בשקט על ידי כלל ברירת המחדל שבתחתית, וזה מתגלה רק
    // כשמשהו מפסיק לעבוד בלי הסבר.
    //
    // ההיקף רחב אך ההרשאה אינה: הגישה מותנית בבעלות בלבד, ולכן משתמש
    // מחובר אינו יכול לקרוא או לכתוב דבר אצל משתמש אחר.
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // ── חדרי הצבעה קבוצתיים ──
    //
    // חדר משותף אינו יכול לחיות תחת users/{uid}, שכן כמה אנשים ניגשים
    // אליו. הגישה נשענת על ידיעת הקוד, ולכן כאן נאכף מה שמונע שימוש לרעה:
    //
    // • list חסום — אי אפשר למנות חדרים או לגלות קוד בסריקה.
    // • ההצבעות ממופתחות לפי מזהה המצביע, וכל משתמש רשאי לשנות אך ורק
    //   את המפתח של עצמו. משתתף אינו יכול למחוק הצבעה של אחר, לשנות
    //   אותה, או להצביע פעמיים.
    // • הקוד והבעלות אינם ניתנים לשינוי לאחר היצירה.
    // • הספירה נגזרת מההצבעות בצד הלקוח ואינה שדה שאפשר לנפח.
    //
    // ולידציה בצד הלקוח אינה נחשבת הגנה: מי שקורא ל-API ישירות עוקף
    // אותה. לכן המבנה והגדלים מאומתים כאן.
    match /groupTrips/{code} {

      function signedIn() {
        return request.auth != null;
      }

      // רשומת ההצבעה של הכותב עצמו — מבנה וגדלים
      function ownVoteValid() {
        return !(request.auth.uid in request.resource.data.votes) || (
          request.resource.data.votes[request.auth.uid].keys().hasOnly(['name', 'choices'])
          && request.resource.data.votes[request.auth.uid].name is string
          && request.resource.data.votes[request.auth.uid].name.size() > 0
          && request.resource.data.votes[request.auth.uid].name.size() <= 40
          && request.resource.data.votes[request.auth.uid].choices is list
          && request.resource.data.votes[request.auth.uid].choices.size() <= 3
        );
      }

      function shapeValid() {
        return request.resource.data.keys().hasOnly(
                 ['code', 'createdBy', 'createdAt', 'expiresAt', 'votes'])
          && request.resource.data.code == code
          && request.resource.data.votes is map
          && request.resource.data.votes.keys().size() <= 50
          && ownVoteValid();
      }

      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && shapeValid()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.votes.keys().hasOnly([request.auth.uid]);

      allow update: if signedIn()
        && shapeValid()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        // הלב של ההגנה: מותר לגעת אך ורק במפתח שלך
        && request.resource.data.votes.diff(resource.data.votes)
             .affectedKeys().hasOnly([request.auth.uid]);

      allow delete: if signedIn() && resource.data.createdBy == request.auth.uid;
    }

    // ── טיול משותף לקריאה ──
    //
    // עד 04.09.2026 "שתף טיול" שלח `?destination=Rome` — שם העיר בלבד,
    // כי הטיולים יושבים תחת users/{uid} ואין למה להפנות. זה המסמך
    // שאפשר להפנות אליו: תמונת מצב, לא מראה חיה של הטיול המקורי.
    //
    // **get פתוח לכל, ו-list חסום.** זו החלטה ולא רשלנות:
    // • הנמען אינו נדרש להתחבר. שיתוף שמחייב הרשמה אינו שיתוף — הוא
    //   דף נחיתה, ובן הזוג שרק רצה לראות את המסלול נוטש.
    // • הקוד באורך 10 תווים מאלפבית בן 31, כלומר כ-8×10^14 צירופים,
    //   ומופק מ-crypto.getRandomValues. אי אפשר לנחש אותו.
    // • list חסום, ולכן אי אפשר למנות קודים בסריקה — בדיוק כמו
    //   ב-groupTrips. בלעדיו כל ההגנה הייתה חסרת ערך.
    // • התוכן נמדד: 25 טיולים, 758KB, אפס מספרי אסמכתה ואפס שמות
    //   נוסעים. השירות שולח רשימת היתר ולא את הטיול כולו.
    match /sharedTrips/{code} {

      function isOwner() {
        return request.auth != null
          && request.auth.uid == resource.data.ownerUid;
      }

      // המבנה נאכף כאן ולא בצד הלקוח: מי שקורא ל-API ישירות עוקף
      // כל ולידציה שנעשית בדפדפן.
      function shapeValid() {
        return request.resource.data.keys().hasOnly(
                 ['code', 'ownerUid', 'mode', 'createdAt', 'expiresAt', 'snapshot',
                  'updatedAt', 'comments', 'editors', 'requests'])
          && request.resource.data.code == code
          && request.resource.data.mode in ['view', 'comment', 'edit']
          && request.resource.data.snapshot is map;
      }

      // ── הערה של הכותב עצמו ──
      //
      // זהו אותו מודל שכבר מוכח ב-groupTrips: ההערות ממופתחות לפי
      // מזהה הכותב, ולכן החוק יכול לאכוף "כל אחד נוגע רק בשלו".
      // בלי זה כל מי שמחזיק בקישור היה יכול למחוק הערה של אחר.
      //
      // המשמעות: **קריאה אינה דורשת התחברות, הערה כן.** אין דרך לאכוף
      // בעלות על הערה בלי זהות, וזהות אנונימית שאפשר לזייף הופכת את
      // הכלל להצגה בלבד.
      function ownCommentOnly() {
        return request.auth != null
          && resource.data.mode == 'comment'
          // רק שדה ההערות משתנה: בלי זה אפשר היה לשנות את המסלול
          // עצמו תוך כדי הוספת הערה.
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && request.resource.data.comments.diff(resource.data.comments)
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.comments[request.auth.uid].keys().hasOnly(['name', 'text', 'at'])
          && request.resource.data.comments[request.auth.uid].name is string
          && request.resource.data.comments[request.auth.uid].name.size() <= 40
          && request.resource.data.comments[request.auth.uid].text is string
          && request.resource.data.comments[request.auth.uid].text.size() > 0
          && request.resource.data.comments[request.auth.uid].text.size() <= 1000;
      }

      // ── עריכה משותפת ──
      //
      // מותרת רק כש-mode הוא 'edit', ורק למשתמש מחובר. הצפייה נשארת
      // פתוחה לכל, אבל **עריכה בלי זהות אינה אפשרית**: קישור שדולף
      // היה נותן לכל אחד למחוק מסלול שלם בלי שאפשר לדעת מי.
      //
      // רק `snapshot` ו-`updatedAt` ניתנים לשינוי. הבעלות, הקוד,
      // התפוגה, המצב וההערות נעולים — אחרת עורך היה יכול להפוך את
      // עצמו לבעלים, או להשאיר את הקישור פתוח לנצח.
      //
      // **המצב עצמו נשלט בידי הבעלים בלבד**, ולכן הוא יכול לסגור את
      // העריכה בכל רגע וזה נאכף מיד.
      // ── עריכה מותרת למי שהמשתף אישר, לא למי שמחזיק בקישור ──
      //
      // עד 05.09.2026 mode=='edit' פתח עריכה לכל משתמש מחובר שהחזיק
      // בקישור. קישור שנשלח בוואטסאפ מועבר הלאה, ולכן "הרשאה לקישור"
      // היא הרשאה לכל מי שהקישור הגיע אליו.
      //
      // עכשיו ההרשאה היא **לאדם**: רק מי שמזההו נמצא ב-`editors`,
      // ורק הבעלים כותב לשם.
      function collaboratorEdit() {
        return request.auth != null
          && resource.data.mode == 'edit'
          && resource.data.editors != null
          && request.auth.uid in resource.data.editors
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['snapshot', 'updatedAt'])
          && request.resource.data.snapshot is map;
      }

      // ── בקשת הרשאה ──
      //
      // אותו מודל שכבר מוכח פעמיים כאן: הבקשות ממופתחות לפי מזהה
      // המבקש, ולכן אדם יכול לבקש רק בשם עצמו — ולא לאשר את עצמו,
      // כי `editors` אינו נוגע.
      function ownRequestOnly() {
        return request.auth != null
          && resource.data.mode == 'edit'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['requests'])
          && request.resource.data.requests.diff(resource.data.requests)
               .affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.requests[request.auth.uid].keys().hasOnly(['name', 'at'])
          && request.resource.data.requests[request.auth.uid].name is string
          && request.resource.data.requests[request.auth.uid].name.size() <= 40;
      }

      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && shapeValid()
        && request.resource.data.ownerUid == request.auth.uid;

      // שני נתיבי עדכון: הבעלים מרענן את תמונת המצב, ומעיר כותב הערה
      // אחת — שלו. הבעלות והקוד אינם ניתנים לשינוי בשום מקרה, אחרת
      // אפשר היה להשתלט על שיתוף קיים או להפנות קוד ידוע לתוכן אחר.
      allow update: if (
          isOwner()
          && shapeValid()
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.code == resource.data.code
        ) || ownCommentOnly() || collaboratorEdit() || ownRequestOnly();

      allow delete: if isOwner();
    }

    // כל השאר חסום. כלל מפורש עדיף על הסתמכות על ברירת המחדל.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
